<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ReleaseCommunications.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ReleaseCommunications.App"
    xmlns:models="using:ReleaseCommunications.Core.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="PrimaryNavigation"
        AutomationProperties.AutomationId="PrimaryNavigation"
        AutomationProperties.Name="{x:Bind ViewModel.Text('PrimaryNavigation'), FallbackValue='Primary navigation'}"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="LeftCompact"
        SelectionChanged="NavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem
                AutomationProperties.AutomationId="DashboardNavigationItem"
                Content="{x:Bind ViewModel.Text('NavUpdates')}"
                Icon="AllApps"
                IsSelected="True"
                Tag="dashboard" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                AutomationProperties.AutomationId="SettingsItem"
                Content="{x:Bind ViewModel.Text('Settings')}"
                Icon="Setting"
                Tag="settings" />
        </NavigationView.FooterMenuItems>

        <Grid Padding="24,20" RowSpacing="16">
            <Grid
                x:Name="DashboardGrid"
                Visibility="{x:Bind local:MainPage.VisibleWhenNot(ViewModel.IsSettingsVisible), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.Text('PageTitle')}" />
                        <TextBlock
                            MaxWidth="820"
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Text('PageSubtitle')}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <CommandBar
                        Grid.Column="1"
                        Background="Transparent"
                        DefaultLabelPosition="Right">
                        <AppBarButton
                            AutomationProperties.AutomationId="RefreshButton"
                            AutomationProperties.Name="{x:Bind ViewModel.Text('RefreshAutomation')}"
                            Command="{x:Bind ViewModel.RefreshCommand}"
                            Icon="Refresh"
                            Label="{x:Bind ViewModel.Text('Refresh')}" />
                        <AppBarButton
                            AutomationProperties.AutomationId="CancelButton"
                            AutomationProperties.Name="{x:Bind ViewModel.Text('CancelAutomation')}"
                            Command="{x:Bind ViewModel.CancelCommand}"
                            Icon="Cancel"
                            IsEnabled="{x:Bind ViewModel.CanCancel, Mode=OneWay}"
                            Label="{x:Bind ViewModel.Text('Cancel')}" />
                    </CommandBar>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollMode="Disabled">
                    <Grid MinWidth="930" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Text('Source')}" />
                            <ComboBox
                                AutomationProperties.AutomationId="SourceFilter"
                                AutomationProperties.Name="{x:Bind ViewModel.Text('Source')}"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind ViewModel.SourceOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedSourceOption, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Text('PublishedPeriod')}" />
                            <ComboBox
                                AutomationProperties.AutomationId="PeriodFilter"
                                AutomationProperties.Name="{x:Bind ViewModel.Text('PublishedPeriod')}"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind ViewModel.PeriodOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Text('Product')}" />
                            <TextBox
                                AutomationProperties.AutomationId="ProductFilter"
                                AutomationProperties.Name="{x:Bind ViewModel.Text('Product')}"
                                PlaceholderText="{x:Bind ViewModel.Text('ProductPlaceholder')}"
                                Text="{x:Bind ViewModel.ProductFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Text('Status')}" />
                            <TextBox
                                AutomationProperties.AutomationId="StatusFilter"
                                AutomationProperties.Name="{x:Bind ViewModel.Text('Status')}"
                                PlaceholderText="{x:Bind ViewModel.Text('StatusPlaceholder')}"
                                Text="{x:Bind ViewModel.StatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Text('TagOrPlatform')}" />
                            <TextBox
                                AutomationProperties.AutomationId="TagFilter"
                                AutomationProperties.Name="{x:Bind ViewModel.Text('TagOrPlatform')}"
                                PlaceholderText="{x:Bind ViewModel.Text('TagPlaceholder')}"
                                Text="{x:Bind ViewModel.TagFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button
                            Grid.Column="5"
                            VerticalAlignment="Bottom"
                            AutomationProperties.AutomationId="ApplyFiltersButton"
                            AutomationProperties.Name="{x:Bind ViewModel.Text('Apply')}"
                            Command="{x:Bind ViewModel.ApplyFiltersCommand}"
                            Content="{x:Bind ViewModel.Text('Apply')}" />
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="8">
                    <ProgressRing
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="LoadingIndicator"
                        AutomationProperties.Name="{x:Bind ViewModel.Text('LoadingAutomation')}"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.IsBusy), Mode=OneWay}" />
                    <InfoBar
                        AutomationProperties.AutomationId="StatusInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                        Severity="Informational" />
                    <InfoBar
                        AutomationProperties.AutomationId="ErrorInfoBar"
                        IsClosable="False"
                        IsOpen="{x:Bind local:MainPage.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Error"
                        Visibility="{x:Bind local:MainPage.VisibleWhenPresent(ViewModel.ErrorMessage), Mode=OneWay}" />
                </StackPanel>

                <Grid x:Name="MasterDetailGrid" Grid.Row="3" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MasterColumn" Width="420" />
                        <ColumnDefinition x:Name="DetailColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="DetailRow" Height="0" />
                    </Grid.RowDefinitions>

                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup>
                            <VisualState x:Name="NarrowLayout">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="0" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="MasterColumn.Width" Value="*" />
                                    <Setter Target="DetailColumn.Width" Value="0" />
                                    <Setter Target="DetailRow.Height" Value="*" />
                                    <Setter Target="ArticleList.MaxHeight" Value="340" />
                                    <Setter Target="DetailHost.(Grid.Column)" Value="0" />
                                    <Setter Target="DetailHost.(Grid.Row)" Value="1" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="WideLayout">
                                <VisualState.StateTriggers>
                                    <AdaptiveTrigger MinWindowWidth="1008" />
                                </VisualState.StateTriggers>
                                <VisualState.Setters>
                                    <Setter Target="MasterColumn.Width" Value="420" />
                                    <Setter Target="DetailColumn.Width" Value="*" />
                                    <Setter Target="DetailRow.Height" Value="0" />
                                    <Setter Target="ArticleList.MaxHeight" Value="10000" />
                                    <Setter Target="DetailHost.(Grid.Column)" Value="1" />
                                    <Setter Target="DetailHost.(Grid.Row)" Value="0" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <Grid>
                        <ListView
                            x:Name="ArticleList"
                            AutomationProperties.AutomationId="ArticleList"
                            AutomationProperties.Name="{x:Bind ViewModel.Text('ArticleListAutomation')}"
                            ItemsSource="{x:Bind ViewModel.Articles, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedArticle, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,10" RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ProductsDisplay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <Grid Grid.Row="2" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12" Text="{Binding SourceDisplay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding PublishedDisplay}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                FontSize="12"
                                                Text="{Binding SummaryStatusDisplay}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind local:MainPage.VisibleForState(ViewModel.State, models:LoadState.Empty), Mode=OneWay}">
                            <FontIcon FontSize="36" Glyph="&#xE8A5;" />
                            <TextBlock
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Text('NoMatchingArticles')}" />
                            <TextBlock Text="{x:Bind ViewModel.Text('NoMatchingArticlesHelp')}" />
                        </StackPanel>
                    </Grid>

                    <Border
                        x:Name="DetailHost"
                        Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.HasSelection), Mode=OneWay}">
                        <ScrollViewer>
                            <StackPanel>
                                <Border
                                    Padding="24"
                                    Background="{ThemeResource ArticleHeroBackgroundBrush}"
                                    CornerRadius="12,12,0,0">
                                    <Grid ColumnSpacing="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="10">
                                            <TextBlock
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Style="{ThemeResource TitleTextBlockStyle}"
                                                Text="{x:Bind ViewModel.SelectedArticle.Title, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock
                                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                    Text="{x:Bind ViewModel.SelectedArticle.SourceDisplay, Mode=OneWay}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                                                    Text="{x:Bind ViewModel.SelectedArticle.PublishedDisplay, Mode=OneWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Grid.Column="1" Width="96" Height="96">
                                            <Ellipse
                                                Fill="{ThemeResource ArticleHeroGlyphBackgroundBrush}"
                                                Opacity="0.9" />
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="44"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Glyph="&#xE753;" />
                                            <FontIcon
                                                Margin="0,0,6,6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                FontSize="24"
                                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                Glyph="&#xE72C;" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel Padding="24" Spacing="18">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.Text('SummaryLanguage')}" />
                                            <ComboBox
                                                AutomationProperties.AutomationId="SummaryLanguage"
                                                AutomationProperties.Name="{x:Bind ViewModel.Text('SummaryLanguage')}"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{x:Bind ViewModel.SummaryLanguageOptions}"
                                                SelectedItem="{x:Bind ViewModel.SelectedSummaryLanguageOption, Mode=TwoWay}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            AutomationProperties.AutomationId="SummarizeSelectedButton"
                                            AutomationProperties.Name="{x:Bind ViewModel.Text('SummarizeSelected')}"
                                            Command="{x:Bind ViewModel.SummarizeSelectedCommand}"
                                            Content="{x:Bind ViewModel.Text('SummarizeSelected')}" />
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Left"
                                            AutomationProperties.AutomationId="SummarizeVisibleButton"
                                            AutomationProperties.Name="{x:Bind ViewModel.Text('SummarizeVisible')}"
                                            Command="{x:Bind ViewModel.SummarizeVisibleCommand}"
                                            Content="{x:Bind ViewModel.Text('SummarizeVisible')}" />
                                    </Grid>

                                    <InfoBar
                                        AutomationProperties.AutomationId="SummaryErrorInfoBar"
                                        IsClosable="False"
                                        IsOpen="True"
                                        Message="{x:Bind ViewModel.SelectedArticle.SummaryError, Mode=OneWay}"
                                        Severity="Error"
                                        Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.HasSelectedSummaryError), Mode=OneWay}" />

                                    <StackPanel
                                        Spacing="10"
                                        Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.HasSelectedSummary), Mode=OneWay}">
                                        <TextBlock
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.Text('AiSummary')}" />
                                        <InfoBar
                                            IsClosable="False"
                                            IsOpen="{x:Bind local:MainPage.HasText(ViewModel.SelectedArticle.SummaryContentNotice), Mode=OneWay}"
                                            Message="{x:Bind ViewModel.SelectedArticle.SummaryContentNotice, Mode=OneWay}"
                                            Severity="Warning"
                                            Visibility="{x:Bind local:MainPage.VisibleWhenPresent(ViewModel.SelectedArticle.SummaryContentNotice), Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.SelectedArticle.Summary.Overview, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Text('KeyPoints')}" />
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedArticle.Summary.KeyPoints, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="8,3,0,3" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon FontSize="10" Glyph="&#xE73E;" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Text('Impact')}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.SelectedArticle.Summary.Impact, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Text('ImportantDates')}" />
                                        <TextBlock
                                            Text="{x:Bind ViewModel.SelectedArticle.Summary.ImportantDates, Mode=OneWay}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <TextBlock
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind ViewModel.Text('OriginalArticle')}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.SelectedArticle.Article.Description, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="24" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Text('Products')}" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.SelectedArticle.ProductsDisplay, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Text('Status')}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedArticle.StatusDisplay, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Text('Published')}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedArticle.PublishedDisplay, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Text('LastUpdated')}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedArticle.UpdatedDisplay, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <HyperlinkButton
                                        HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="OpenSourceArticleButton"
                                        AutomationProperties.Name="{x:Bind ViewModel.Text('OpenOriginalAutomation')}"
                                        Content="{x:Bind ViewModel.Text('OpenOriginal')}"
                                        Click="OpenSourceArticle_Click" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <ScrollViewer
                Visibility="{x:Bind local:MainPage.VisibleWhen(ViewModel.IsSettingsVisible), Mode=OneWay}">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="18">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Text('Settings')}" />
                    <TextBlock Text="{x:Bind ViewModel.Text('SettingsIntro')}" TextWrapping="Wrap" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.Text('UiLanguage')}" />
                            <ComboBox
                                AutomationProperties.AutomationId="UiLanguageComboBox"
                                AutomationProperties.Name="{x:Bind ViewModel.Text('UiLanguage')}"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind ViewModel.UiLanguageOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedUiLanguageOption, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.Text('SummaryLanguageSetting')}" />
                            <ComboBox
                                AutomationProperties.AutomationId="DefaultSummaryLanguageComboBox"
                                AutomationProperties.Name="{x:Bind ViewModel.Text('SummaryLanguageSetting')}"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind ViewModel.SummaryLanguageOptions}"
                                SelectedItem="{x:Bind ViewModel.SelectedSummaryLanguageOption, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.Text('Endpoint')}" />
                        <TextBox
                            AutomationProperties.AutomationId="FoundryEndpointTextBox"
                            AutomationProperties.Name="{x:Bind ViewModel.Text('Endpoint')}"
                            PlaceholderText="https://&lt;resource-name&gt;.services.ai.azure.com/openai/v1"
                            Text="{x:Bind ViewModel.FoundryProjectEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.Text('Deployment')}" />
                        <TextBox
                            AutomationProperties.AutomationId="FoundryDeploymentTextBox"
                            AutomationProperties.Name="{x:Bind ViewModel.Text('Deployment')}"
                            Text="{x:Bind ViewModel.FoundryDeploymentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.Text('DeploymentHelp')}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.Text('MaximumArticles')}" />
                            <NumberBox
                                AutomationProperties.AutomationId="MaximumItemsNumberBox"
                                AutomationProperties.Name="{x:Bind ViewModel.Text('MaximumArticles')}"
                                Maximum="500"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.MaximumItems, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.Text('SummaryConcurrency')}" />
                            <NumberBox
                                AutomationProperties.AutomationId="SummaryConcurrencyNumberBox"
                                AutomationProperties.Name="{x:Bind ViewModel.Text('SummaryConcurrency')}"
                                Maximum="8"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.SummaryConcurrency, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.Text('CacheRetention')}" />
                            <NumberBox
                                AutomationProperties.AutomationId="CacheRetentionNumberBox"
                                AutomationProperties.Name="{x:Bind ViewModel.Text('CacheRetention')}"
                                Maximum="90"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.CacheRetentionDays, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            AutomationProperties.AutomationId="SaveSettingsButton"
                            AutomationProperties.Name="{x:Bind ViewModel.Text('Save')}"
                            Command="{x:Bind ViewModel.SaveSettingsCommand}"
                            Content="{x:Bind ViewModel.Text('Save')}" />
                        <Button
                            AutomationProperties.AutomationId="CheckConnectionsButton"
                            AutomationProperties.Name="{x:Bind ViewModel.Text('CheckConnections')}"
                            Command="{x:Bind ViewModel.CheckConnectionsCommand}"
                            Content="{x:Bind ViewModel.Text('CheckConnections')}" />
                    </StackPanel>
                    <InfoBar
                        AutomationProperties.AutomationId="SettingsStatusInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.SettingsStatus, Mode=OneWay}"
                        Severity="Informational" />
                    <HyperlinkButton
                        AutomationProperties.AutomationId="ApiTermsLink"
                        AutomationProperties.Name="{x:Bind ViewModel.Text('ApiTerms')}"
                        Content="{x:Bind ViewModel.Text('ApiTerms')}"
                        NavigateUri="https://learn.microsoft.com/legal/microsoft-apis/terms-of-use" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Page>
